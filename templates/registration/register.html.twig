{% extends 'home.html.twig' %}

{% block title %}Register{% endblock %}
{% block footer %}{% endblock %}
{% block body %}
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
    <div class="container mt-4">
        <div class="card mx-auto" style="max-width: 600px;">
            <div class="card-body">
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <h1 class="text-center mb-4">S'inscrire</h1>

                        {{ form_row(registrationForm.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom'}}) }}
                        {{ form_row(registrationForm.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
                        {{ form_row(registrationForm.email, {'attr': {'class': 'form-control', 'placeholder': 'Email'}}) }}
                        {{ form_row(registrationForm.travail, {'attr': {'class': 'form-control'}}) }}
                        {{ form_row(registrationForm.numTel, {'attr': {'class': 'form-control', 'placeholder': 'Numéro de téléphone'}}) }}
                        {{ form_row(registrationForm.photoUrl, {'attr': {'class': 'form-control'}}) }}
                        {{ form_row(registrationForm.plainPassword, {'attr': {'class': 'form-control', 'placeholder': 'Mot de passe'}}) }}
                        {{ form_row(registrationForm.agreeTerms) }}

                        {{ form_errors(registrationForm) }}

                        <div class="text-center mt-4">
                            <button type="reset" class="btn btn-secondary" style="background-color: #F14823;">Annuler</button>
                            <button type="submit" class="btn btn-primary">S'inscrire</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{ form_end(registrationForm) }}
{% endblock %}